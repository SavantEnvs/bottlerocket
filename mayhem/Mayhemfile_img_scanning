project: savantenvs/bottlerocket
target: img-scanning

# Server-accumulated corpus (REQUIRED for accumulation) + per-target starter seeds
# (small valid GPT disk images at 512- and 4096-byte sector sizes, generated by
# mayhem/img-scanning/mkseeds.py; relative path, resolved on the runner).
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/img-scanning/testsuite

cmds:
  - cmd: /mayhem/img_scanning
    libfuzzer: true
